.tab-shell { position: fixed; z-index: 1000; left: 22rpx; right: 22rpx; bottom: 18rpx; padding-bottom: env(safe-area-inset-bottom); }
.tab-bar { height: 116rpx; padding: 10rpx 16rpx; display: flex; align-items: center; border: 1rpx solid rgba(205,225,239,.92); border-radius: 36rpx; background: rgba(255,255,255,.96); box-shadow: 0 18rpx 48rpx rgba(24,67,103,.17); }
.tab-item { flex: 1; height: 94rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #71899e; }
.icon-wrap { width: 54rpx; height: 50rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; }
.tab-icon { width: 34rpx; height: 34rpx; opacity: .52; }
.tab-text { margin-top: 2rpx; font-size: 20rpx; line-height: 25rpx; font-weight: 600; }
.tab-item--active { color: #0b76e7; }
.tab-item--active .icon-wrap { background: #e6f3ff; }
.tab-item--active .tab-icon { opacity: 1; }

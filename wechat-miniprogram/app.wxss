page {
  min-height: 100%;
  color: #102a49;
  background: #f3f8fd;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.45;
}

view, text, button, input, picker, scroll-view, swiper, swiper-item, canvas {
  box-sizing: border-box;
}

button::after { border: none; }
button { margin: 0; padding: 0; background: transparent; line-height: 1.4; }

.page-shell {
  min-height: 100vh;
  padding: 0 28rpx calc(156rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  position: relative;
}

.page-shell::before {
  content: "";
  position: fixed;
  z-index: -2;
  top: -220rpx;
  right: -170rpx;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(48, 164, 255, .22) 0%, rgba(48, 164, 255, 0) 68%);
}

.page-shell::after {
  content: "";
  position: fixed;
  z-index: -3;
  inset: 0;
  background: linear-gradient(160deg, #fbfdff 0%, #f2f8fe 52%, #edf6ff 100%);
}

.card {
  border: 1rpx solid rgba(201, 222, 238, .82);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 18rpx 48rpx rgba(27, 82, 128, .09);
}

.glass-card {
  border: 1rpx solid rgba(255, 255, 255, .86);
  border-radius: 32rpx;
  background: rgba(247, 252, 255, .82);
  box-shadow: 0 18rpx 48rpx rgba(27, 82, 128, .09);
  backdrop-filter: blur(24rpx);
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 36rpx 4rpx 20rpx;
}

.section-title { font-size: 34rpx; font-weight: 700; letter-spacing: -.5rpx; color: #0b2b50; }
.section-caption { margin-top: 5rpx; font-size: 23rpx; color: #607b94; }
.section-action { color: #0d7cf0; font-size: 25rpx; font-weight: 600; }

.primary-btn, .secondary-btn, .ghost-btn, .danger-btn {
  min-height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 650;
  transition: transform .16s ease, opacity .16s ease;
}

.primary-btn { color: #fff; background: linear-gradient(135deg, #299bff 0%, #0869e8 100%); box-shadow: 0 14rpx 30rpx rgba(18, 130, 255, .25); }
.secondary-btn { color: #0b70df; background: #e8f4ff; border: 1rpx solid #c7e2fb; }
.ghost-btn { color: #375974; background: #f4f8fb; border: 1rpx solid #dceaf4; }
.danger-btn { color: #d9445e; background: #fff0f3; border: 1rpx solid #ffd4dc; }
.primary-btn[disabled], .secondary-btn[disabled] { opacity: .46; }
.primary-btn:active, .secondary-btn:active, .ghost-btn:active, .danger-btn:active { transform: scale(.975); opacity: .9; }

.eyebrow { color: #3185ce; font-size: 22rpx; font-weight: 650; letter-spacing: 2rpx; text-transform: uppercase; }
.muted { color: #5d7891; }
.faint { color: #7890a5; }
.number-font { font-family: "DIN Alternate", "SF Pro Display", Arial, sans-serif; font-variant-numeric: tabular-nums; }

.hairline { height: 1rpx; background: #e6eff6; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }

.field-label { display: block; margin-bottom: 13rpx; color: #496984; font-size: 24rpx; font-weight: 600; }
.field-box {
  min-height: 92rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #cfe0ed;
  border-radius: 24rpx;
  background: #fafdff;
  color: #102a49;
  font-size: 29rpx;
}
.field-box--focus { border-color: #55a8f5; box-shadow: 0 0 0 6rpx rgba(32, 143, 245, .08); }

.safe-bottom { height: env(safe-area-inset-bottom); }

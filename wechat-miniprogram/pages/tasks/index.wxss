.tasks-page { padding-left:26rpx;padding-right:26rpx; }
.search-box { height:88rpx;padding:0 22rpx;display:flex;align-items:center;border:1rpx solid #d4e4ef;border-radius:26rpx;background:rgba(255,255,255,.86);box-shadow:0 10rpx 25rpx rgba(35,79,115,.06); }
.search-icon { width:27rpx;height:27rpx;margin-right:17rpx;border:3rpx solid #7290a7;border-radius:50%;position:relative; }.search-icon::after{content:"";position:absolute;right:-9rpx;bottom:-6rpx;width:12rpx;height:3rpx;background:#7290a7;transform:rotate(45deg);border-radius:3rpx;}
.search-input { flex:1;height:88rpx;color:#173853;font-size:27rpx; }.search-placeholder{color:#8aa0b2}.clear-btn{width:46rpx;height:46rpx;border-radius:16rpx;background:#edf3f7;color:#71899e;font-size:30rpx;display:flex;align-items:center;justify-content:center;}
.filter-scroll { width:100%;margin-top:20rpx;white-space:nowrap; }.filter-row{display:inline-flex;gap:14rpx;padding:2rpx 2rpx 6rpx;}
.filter-chip { height:62rpx;padding:0 25rpx;border-radius:20rpx;color:#5b7690;background:#edf3f7;font-size:23rpx;font-weight:600;display:flex;align-items:center; }
.filter-chip--active { color:#fff;background:linear-gradient(135deg,#299bff,#0d70e7);box-shadow:0 9rpx 18rpx rgba(18,130,255,.2); }
.task-summary { margin:22rpx 3rpx 17rpx;display:flex;align-items:center;justify-content:space-between;color:#68839a;font-size:22rpx; }.summary-number{color:#163653;font-size:32rpx;font-weight:700}.summary-unit{font-size:22rpx}.autosave{display:flex;align-items:center;gap:8rpx}.autosave-check{width:27rpx;height:27rpx;border-radius:50%;background:#e3f8f0;color:#11a579;font-size:17rpx;font-weight:700;display:flex;align-items:center;justify-content:center;}
.task-list { display:flex;flex-direction:column;gap:18rpx; }
.task-card { display:flex;overflow:hidden;transition:transform .16s ease; }.task-card:active{transform:scale(.988)}
.task-color { width:9rpx;flex:none; }.task-card-main{flex:1;min-width:0;padding:24rpx 24rpx 21rpx;}
.task-card-top { display:flex;align-items:center;justify-content:space-between; }
.more-btn { width:52rpx;height:48rpx;display:flex;align-items:center;justify-content:center;gap:5rpx;border-radius:17rpx;background:#f4f8fb; }.more-btn view{width:5rpx;height:5rpx;border-radius:50%;background:#71899e;}
.task-title { display:block;margin-top:17rpx;color:#102f4d;font-size:30rpx;font-weight:720;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }.task-origin{display:block;margin-top:4rpx;color:#6d859b;font-size:21rpx;}
.task-stats { margin-top:23rpx;display:flex;align-items:center; }.stat-cell{flex:1;min-width:0;display:flex;flex-direction:column}.stat-label{color:#7890a5;font-size:19rpx}.stat-value{margin-top:4rpx;color:#294d69;font-size:22rpx;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.stat-divider{width:1rpx;height:43rpx;margin:0 16rpx;background:#e4edf4;}
.progress-track { height:7rpx;margin-top:20rpx;border-radius:7rpx;background:#edf3f7;overflow:hidden; }.progress-fill{height:100%;border-radius:7rpx;transition:width .3s ease;}
.task-card-bottom { margin-top:17rpx;display:flex;align-items:center;justify-content:space-between;color:#4c6d86;font-size:21rpx; }.next-button{width:42rpx;height:42rpx;border-radius:14rpx;background:#eef6fc;font-size:31rpx;display:flex;align-items:center;justify-content:center;}
.floating-create { position:fixed;z-index:20;right:31rpx;bottom:calc(155rpx + env(safe-area-inset-bottom));height:82rpx;padding:0 26rpx 0 20rpx;border-radius:27rpx;color:#fff;background:linear-gradient(135deg,#299bff,#0869e8);box-shadow:0 16rpx 35rpx rgba(18,130,255,.29);display:flex;align-items:center;gap:9rpx;font-size:25rpx;font-weight:650; }.floating-plus{font-size:36rpx;font-weight:400;}
.empty-state { padding:90rpx 45rpx 20rpx;display:flex;flex-direction:column;align-items:center;text-align:center; }.empty-illustration{width:190rpx;height:150rpx;position:relative}.empty-sheet{position:absolute;left:36rpx;top:12rpx;width:115rpx;height:132rpx;padding:28rpx 24rpx;border-radius:24rpx;background:#fff;border:1rpx solid #d7e7f2;box-shadow:0 15rpx 35rpx rgba(35,83,121,.1);transform:rotate(-3deg)}.empty-sheet view{height:7rpx;margin-bottom:14rpx;border-radius:7rpx;background:#dceaf5}.empty-sheet view:nth-child(2){width:72%}.empty-sheet view:nth-child(3){width:85%}.empty-plus{position:absolute;right:12rpx;bottom:0;width:60rpx;height:60rpx;border-radius:21rpx;background:linear-gradient(145deg,#42adff,#1573e7);color:#fff;font-size:35rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 10rpx 23rpx rgba(22,119,229,.24)}.empty-title{margin-top:25rpx;font-size:32rpx;font-weight:720}.empty-copy{max-width:500rpx;margin-top:10rpx;color:#69839a;font-size:24rpx;line-height:1.7}.empty-action{width:330rpx;margin-top:31rpx;}
.skeleton-list{display:flex;flex-direction:column;gap:18rpx}.skeleton-card{height:300rpx;padding:28rpx;border-radius:30rpx;background:#fff}.skeleton-line{height:25rpx;margin-top:24rpx;border-radius:15rpx;background:linear-gradient(90deg,#edf3f7,#f7fafc,#edf3f7);background-size:200% 100%;animation:shimmer 1.3s infinite}.skeleton-line--short{width:30%;margin-top:0}.skeleton-line--mid{width:65%}@keyframes shimmer{from{background-position:100% 0}to{background-position:-100% 0}}

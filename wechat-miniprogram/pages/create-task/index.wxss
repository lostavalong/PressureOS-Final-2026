.create-page{padding-left:26rpx;padding-right:26rpx;padding-bottom:calc(45rpx + env(safe-area-inset-bottom));}
.step-label{margin:18rpx 3rpx 19rpx;display:flex;align-items:flex-start;gap:16rpx}.step-label--second{margin-top:37rpx}.step-number{width:48rpx;height:37rpx;border-radius:13rpx;background:#e7f3ff;color:#147be9;font-size:19rpx;font-weight:700;display:flex;align-items:center;justify-content:center}.step-title{display:block;color:#123351;font-size:29rpx;font-weight:720}.step-copy{display:block;margin-top:2rpx;color:#6b849a;font-size:21rpx}
.template-scroll{width:calc(100% + 26rpx);margin-right:-26rpx;white-space:nowrap}.template-row{display:inline-flex;gap:15rpx;padding:3rpx 26rpx 16rpx 2rpx}
.template-option{width:205rpx;height:196rpx;padding:20rpx;border:1rpx solid #d7e5ef;border-radius:28rpx;background:rgba(255,255,255,.82);position:relative;box-shadow:0 10rpx 24rpx rgba(32,76,112,.05);transition:transform .15s ease}.template-option:active{transform:scale(.98)}.template-option--active{border-width:3rpx;background:#fff;box-shadow:0 13rpx 28rpx rgba(32,91,145,.12)}
.option-icon{width:58rpx;height:58rpx;border-radius:19rpx;display:flex;align-items:center;justify-content:center;font-size:20rpx;font-weight:800}.option-name{display:block;margin-top:14rpx;color:#163754;font-size:25rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.option-category{display:block;margin-top:5rpx;color:#7890a5;font-size:20rpx}.selected-mark{position:absolute;right:14rpx;top:14rpx;width:32rpx;height:32rpx;border-radius:50%;color:#fff;font-size:19rpx;display:flex;align-items:center;justify-content:center}
.template-preview{margin-top:3rpx;display:flex;overflow:hidden}.preview-accent{width:8rpx;flex:none}.preview-main{flex:1;min-width:0;padding:24rpx}.preview-name{max-width:420rpx;color:#123351;font-size:27rpx;font-weight:720;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.preview-description{display:block;margin-top:13rpx;color:#57738b;font-size:22rpx;line-height:1.65}.preview-tags{margin-top:14rpx;display:flex;gap:9rpx;flex-wrap:wrap}.preview-tags text{padding:7rpx 12rpx;border-radius:11rpx;background:#f0f6fa;color:#57758d;font-size:18rpx}.preview-meta{margin-top:16rpx;display:flex;gap:9rpx;color:#7890a5;font-size:20rpx}
.form-card{padding:27rpx}.name-input{flex:1;height:90rpx;font-size:27rpx}.char-count{color:#8aa0b1;font-size:19rpx}.field-help{display:block;margin-top:10rpx;color:#7991a6;font-size:20rpx;line-height:1.5}.field-help--block{margin-top:2rpx}.form-divider{height:1rpx;margin:27rpx 0;background:#e6eef5}.point-label{margin:0}.stepper{height:72rpx;padding:0 8rpx;display:flex;align-items:center;gap:16rpx;border-radius:22rpx;background:#f0f6fa}.stepper button{width:53rpx;height:53rpx;border-radius:17rpx;background:#fff;color:#277dbd;font-size:30rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 5rpx 13rpx rgba(30,74,111,.08)}.stepper text{min-width:36rpx;text-align:center;font-size:29rpx;font-weight:700}
.save-note{margin:22rpx 6rpx;display:flex;align-items:flex-start;gap:12rpx;color:#627d94;font-size:21rpx;line-height:1.55}.save-icon{width:30rpx;height:30rpx;flex:none;border-radius:50%;background:#e4f8f1;color:#11a579;font-size:18rpx;font-weight:700;display:flex;align-items:center;justify-content:center}.create-submit{width:100%;margin-top:22rpx}

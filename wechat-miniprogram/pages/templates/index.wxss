.templates-page{padding-left:26rpx;padding-right:26rpx}.template-hero{height:340rpx;padding:31rpx;border-radius:34rpx;overflow:hidden;position:relative;color:#fff;background:linear-gradient(135deg,#0876e8 0%,#168fff 52%,#45b7ff 100%);box-shadow:0 20rpx 45rpx rgba(20,123,226,.24)}.hero-light{position:absolute;right:-120rpx;top:-170rpx;width:460rpx;height:460rpx;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.24),rgba(255,255,255,0) 65%)}.hero-content{width:72%;position:relative;z-index:2}.hero-eyebrow{font-size:18rpx;letter-spacing:3rpx;color:rgba(255,255,255,.72);font-weight:700}.hero-title{display:block;margin-top:13rpx;font-size:38rpx;line-height:1.3;font-weight:760;letter-spacing:-1rpx}.hero-copy{display:block;margin-top:10rpx;color:rgba(255,255,255,.79);font-size:21rpx;line-height:1.55}.hero-stats{margin-top:23rpx;display:flex;align-items:center}.hero-stats>view:not(.hero-divider){display:flex;flex-direction:column;color:rgba(255,255,255,.72);font-size:17rpx}.hero-number{color:#fff;font-size:27rpx;font-weight:700}.hero-divider{width:1rpx;height:40rpx;margin:0 17rpx;background:rgba(255,255,255,.25)}
.blueprint-art{position:absolute;right:22rpx;bottom:25rpx;width:150rpx;height:170rpx}.art-square{position:absolute;width:57rpx;height:57rpx;border:2rpx solid rgba(255,255,255,.65);border-radius:17rpx;background:rgba(255,255,255,.1);backdrop-filter:blur(5rpx)}.art-square::after{content:"";position:absolute;inset:17rpx;border-radius:5rpx;background:#fff}.art-square--one{right:9rpx;top:0}.art-square--two{left:0;top:62rpx}.art-square--three{right:9rpx;bottom:0}.art-line{position:absolute;left:55rpx;top:49rpx;width:55rpx;height:75rpx;border-left:2rpx solid rgba(255,255,255,.55);border-bottom:2rpx solid rgba(255,255,255,.55);transform:skewY(-38deg)}
.search-box{height:84rpx;margin-top:22rpx;padding:0 22rpx;display:flex;align-items:center;border:1rpx solid #d5e4ef;border-radius:25rpx;background:rgba(255,255,255,.86)}.search-icon{width:26rpx;height:26rpx;margin-right:17rpx;border:3rpx solid #7290a7;border-radius:50%;position:relative}.search-icon::after{content:"";position:absolute;right:-9rpx;bottom:-6rpx;width:12rpx;height:3rpx;background:#7290a7;transform:rotate(45deg)}.search-input{flex:1;height:84rpx;font-size:25rpx}.search-placeholder{color:#8aa0b2}
.category-scroll{width:calc(100% + 26rpx);margin-top:17rpx;margin-right:-26rpx;white-space:nowrap}.category-row{display:inline-flex;gap:12rpx;padding:2rpx 26rpx 4rpx 1rpx}.category-chip{height:57rpx;padding:0 21rpx;border-radius:19rpx;color:#5f7991;background:#edf3f7;font-size:21rpx;font-weight:600;display:flex;align-items:center}.category-chip--active{color:#0b76e7;background:#e4f2ff;border:1rpx solid #c5e1fa}.template-head{margin-top:29rpx}.template-list{display:flex;flex-direction:column;gap:18rpx}
.template-card{padding:25rpx;transition:transform .16s ease}.template-card:active{transform:scale(.987)}.template-card-top{display:flex;align-items:center;gap:18rpx}.template-icon{width:72rpx;height:72rpx;flex:none;border-radius:23rpx;display:flex;align-items:center;justify-content:center;font-size:20rpx;font-weight:800}.template-heading{flex:1;min-width:0}.template-name{max-width:370rpx;color:#123351;font-size:28rpx;font-weight:720;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.template-version{display:block;margin-top:5rpx;color:#7890a5;font-size:20rpx}.template-description{display:block;margin-top:18rpx;color:#56728a;font-size:22rpx;line-height:1.65}.template-tags{margin-top:14rpx;display:flex;gap:9rpx;flex-wrap:wrap}.template-tags text{padding:7rpx 12rpx;border-radius:11rpx;color:#57758d;background:#f0f6fa;font-size:18rpx}.template-bottom{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #e7eff5;display:flex;align-items:center;justify-content:space-between}.template-meta{display:flex;gap:8rpx;color:#758da2;font-size:19rpx}.use-template{font-size:21rpx;font-weight:650}.use-template text{font-size:29rpx}
.import-banner{margin-top:21rpx;padding:23rpx;display:flex;align-items:center;gap:18rpx;border:2rpx dashed #bfdcf3;border-radius:29rpx;background:rgba(235,247,255,.68)}.import-icon{width:65rpx;height:65rpx;flex:none;border-radius:21rpx;background:#fff;color:#167be8;font-size:19rpx;font-weight:800;display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 7rpx 17rpx rgba(25,91,143,.09)}.import-plus{position:absolute;right:-6rpx;bottom:-5rpx;width:28rpx;height:28rpx;border-radius:10rpx;background:#1683ff;color:#fff;font-size:18rpx;display:flex;align-items:center;justify-content:center}.import-title{display:block;color:#173854;font-size:25rpx;font-weight:700}.import-copy{display:block;margin-top:3rpx;color:#6b849a;font-size:19rpx}.chevron{color:#87a0b4;font-size:39rpx}
.sheet-mask{position:fixed;z-index:2000;inset:0;background:rgba(5,25,45,.42);backdrop-filter:blur(7rpx);display:flex;align-items:flex-end}.import-sheet{width:100%;padding:12rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:40rpx 40rpx 0 0;background:#fafdff;box-shadow:0 -20rpx 60rpx rgba(7,40,70,.18)}.sheet-handle{width:75rpx;height:8rpx;margin:0 auto 24rpx;border-radius:8rpx;background:#d5e2eb}.sheet-head{display:flex;align-items:flex-start;justify-content:space-between}.sheet-title{display:block;color:#102f4d;font-size:34rpx;font-weight:750}.sheet-subtitle{display:block;margin-top:5rpx;color:#6f879c;font-size:21rpx}.sheet-close{width:58rpx;height:58rpx;border-radius:20rpx;background:#edf3f7;color:#627d94;font-size:34rpx;display:flex;align-items:center;justify-content:center}.security-flow{margin-top:28rpx;padding:23rpx 11rpx;display:flex;align-items:flex-start;justify-content:space-between;border-radius:25rpx;background:#f0f7fc}.security-step{width:25%;display:flex;flex-direction:column;align-items:center;color:#526f87;font-size:18rpx;position:relative}.security-step:not(:last-child)::after{content:"";position:absolute;left:70%;top:19rpx;width:60%;height:2rpx;background:#c9deed}.flow-index{width:39rpx;height:39rpx;margin-bottom:9rpx;border-radius:14rpx;background:#fff;color:#147be8;font-size:19rpx;font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:0 5rpx 12rpx rgba(31,81,120,.08)}.security-note{margin:20rpx 2rpx 25rpx;padding:18rpx;display:flex;align-items:flex-start;gap:12rpx;border-radius:20rpx;background:#e8f8f2;color:#3e6d5e;font-size:20rpx;line-height:1.55}.shield-mark{width:31rpx;height:31rpx;flex:none;border-radius:11rpx;background:#19b987;color:#fff;font-size:18rpx;font-weight:700;display:flex;align-items:center;justify-content:center}.import-primary,.import-secondary{width:100%}.import-secondary{margin-top:14rpx}

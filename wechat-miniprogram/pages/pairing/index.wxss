.pair-page{min-height:100vh;background:#f5f9fd}.pair-hero{min-height:605rpx;padding:0 28rpx 50rpx;color:#fff;text-align:center;background:linear-gradient(150deg,#075ecb 0%,#1185f4 55%,#45baff 100%);border-radius:0 0 52rpx 52rpx;box-shadow:0 18rpx 45rpx rgba(16,112,208,.22);position:relative;overflow:hidden}.pair-hero::after{content:"";position:absolute;right:-180rpx;top:-160rpx;width:570rpx;height:570rpx;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.2),rgba(255,255,255,0) 65%)}.pair-visual{width:360rpx;height:230rpx;margin:12rpx auto 0;position:relative}.radar-ring{position:absolute;left:50%;top:50%;border:1rpx solid rgba(255,255,255,.18);border-radius:50%;transform:translate(-50%,-50%)}.radar-ring--outer{width:340rpx;height:210rpx}.radar-ring--inner{width:245rpx;height:150rpx}.phone-shape{position:absolute;left:22rpx;top:32rpx;width:105rpx;height:168rpx;padding:8rpx;border:3rpx solid #fff;border-radius:25rpx;background:rgba(255,255,255,.14);transform:rotate(-4deg)}.phone-screen{height:100%;border-radius:17rpx;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center}.scan-corners{width:55rpx;height:55rpx;position:relative}.scan-corners view{position:absolute;width:18rpx;height:18rpx;border-color:#fff;border-style:solid}.scan-corners view:nth-child(1){left:0;top:0;border-width:3rpx 0 0 3rpx}.scan-corners view:nth-child(2){right:0;top:0;border-width:3rpx 3rpx 0 0}.scan-corners view:nth-child(3){left:0;bottom:0;border-width:0 0 3rpx 3rpx}.scan-corners view:nth-child(4){right:0;bottom:0;border-width:0 3rpx 3rpx 0}.meter-shape{position:absolute;right:15rpx;top:56rpx;width:130rpx;height:120rpx;border:3rpx solid rgba(255,255,255,.85);border-radius:27rpx;background:rgba(255,255,255,.16);transform:rotate(3deg)}.meter-display{margin:21rpx 17rpx 0;height:48rpx;border-radius:12rpx;background:rgba(255,255,255,.94);color:#1478e4;font-size:23rpx;font-weight:800;display:flex;align-items:center;justify-content:center}.meter-dot{width:12rpx;height:12rpx;margin:13rpx auto 0;border-radius:50%;background:#5dffc6}.signal-line{position:absolute;left:139rpx;top:98rpx;width:78rpx;display:flex;align-items:center;gap:8rpx}.signal-line view{width:9rpx;height:9rpx;border-radius:50%;background:rgba(255,255,255,.8);animation:pulse 1.2s infinite}.signal-line view:nth-child(2){animation-delay:.2s}.signal-line view:nth-child(3){animation-delay:.4s}@keyframes pulse{0%,100%{opacity:.35;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}.pair-visual--success .phone-shape,.pair-visual--success .signal-line{opacity:.35}.pair-hero-title{display:block;margin-top:4rpx;font-size:37rpx;font-weight:760}.pair-hero-copy{display:block;max-width:550rpx;margin:11rpx auto 0;color:rgba(255,255,255,.78);font-size:22rpx;line-height:1.6}
.pair-content{padding:26rpx 27rpx calc(40rpx + env(safe-area-inset-bottom))}.pair-steps{padding:10rpx 25rpx}.pair-step{min-height:98rpx;display:flex;align-items:center;gap:17rpx}.step-index{width:43rpx;height:43rpx;flex:none;border-radius:15rpx;color:#147be8;background:#e7f3ff;font-size:21rpx;font-weight:700;display:flex;align-items:center;justify-content:center}.pair-step text:first-child{display:block;color:#21425e;font-size:23rpx;font-weight:650}.pair-step text:last-child{display:block;margin-top:3rpx;color:#7690a5;font-size:19rpx}.step-line{width:2rpx;height:20rpx;margin:-10rpx 0 -10rpx 21rpx;background:#d6e7f3}.scan-btn{width:100%;margin-top:22rpx;gap:13rpx}.scan-mini{width:31rpx;height:31rpx;position:relative}.scan-mini view{position:absolute;width:11rpx;height:11rpx;border-color:#fff;border-style:solid}.scan-mini view:nth-child(1){left:0;top:0;border-width:3rpx 0 0 3rpx}.scan-mini view:nth-child(2){right:0;top:0;border-width:3rpx 3rpx 0 0}.scan-mini view:nth-child(3){left:0;bottom:0;border-width:0 0 3rpx 3rpx}.scan-mini view:nth-child(4){right:0;bottom:0;border-width:0 3rpx 3rpx 0}.mock-btn{width:100%;margin-top:13rpx}
.found-card{padding:25rpx}.found-head{display:flex;align-items:center;gap:15rpx}.found-icon{width:65rpx;height:65rpx;border-radius:21rpx;background:linear-gradient(145deg,#4db5ff,#1574e8);color:#fff;font-size:20rpx;font-weight:800;display:flex;align-items:center;justify-content:center}.found-name{display:block;color:#173854;font-size:25rpx;font-weight:700}.found-endpoint{display:block;margin-top:3rpx;color:#7890a5;font-size:18rpx}.pair-code{margin-top:24rpx;padding:23rpx;text-align:center;border-radius:23rpx;background:#f0f7fc}.code-label{display:block;color:#668197;font-size:20rpx}.code-number{display:block;margin-top:4rpx;color:#0a3a68;font-size:48rpx;font-weight:700;letter-spacing:7rpx}.code-hint{display:block;margin-top:2rpx;color:#8197aa;font-size:18rpx}.fingerprint{margin-top:17rpx;padding-top:16rpx;border-top:1rpx solid #e6eef4;display:flex;align-items:center;justify-content:space-between;color:#7890a5;font-size:18rpx}.fingerprint text:last-child{color:#365a74}.permission-preview{margin-top:19rpx;padding:22rpx;border-radius:25rpx;background:#fff}.permission-preview-title{display:block;color:#294c68;font-size:22rpx;font-weight:650}.permission-chip-row{margin-top:13rpx;display:flex;gap:8rpx;flex-wrap:wrap}.permission-chip-row text{padding:8rpx 12rpx;border-radius:11rpx;color:#1675d9;background:#e8f4ff;font-size:18rpx}.permission-limit{display:block;margin-top:14rpx;color:#b26929;font-size:18rpx;line-height:1.5}.confirm-btn,.rescan-btn{width:100%}.confirm-btn{margin-top:19rpx}.rescan-btn{margin-top:12rpx}.success-panel{padding:12rpx 25rpx 0;text-align:center}.success-check{width:105rpx;height:105rpx;margin:0 auto;border-radius:37rpx;background:linear-gradient(145deg,#47d3a7,#0dae7a);color:#fff;font-size:55rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 15rpx 30rpx rgba(18,177,128,.22)}.success-title{display:block;margin-top:22rpx;color:#143551;font-size:32rpx;font-weight:730}.success-copy{display:block;margin-top:9rpx;color:#69849a;font-size:21rpx;line-height:1.65}.finish-btn{width:100%;margin-top:26rpx}.privacy-note{margin-top:22rpx;padding:18rpx;display:flex;align-items:flex-start;gap:12rpx;color:#718a9f;font-size:18rpx;line-height:1.5}.lock-icon{width:24rpx;height:21rpx;flex:none;margin-top:8rpx;border:3rpx solid #7793a9;border-radius:6rpx;position:relative}.lock-icon::before{content:"";position:absolute;left:4rpx;top:-14rpx;width:10rpx;height:13rpx;border:3rpx solid #7793a9;border-bottom:0;border-radius:8rpx 8rpx 0 0}

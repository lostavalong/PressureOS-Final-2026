.device-page{padding-left:26rpx;padding-right:26rpx}.identity-card{padding:27rpx;border-radius:34rpx;color:#fff;background:linear-gradient(135deg,#0c69d9 0%,#1589fa 58%,#3db5ff 100%);box-shadow:0 20rpx 45rpx rgba(18,118,218,.24);position:relative;overflow:hidden}.identity-glow{position:absolute;right:-90rpx;top:-130rpx;width:360rpx;height:360rpx;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.25),rgba(255,255,255,0) 65%)}.identity-top{display:flex;align-items:center;gap:17rpx;position:relative}.device-cube{width:75rpx;height:75rpx;flex:none;border-radius:24rpx;background:rgba(255,255,255,.18);border:1rpx solid rgba(255,255,255,.28);position:relative}.cube-screen{position:absolute;left:17rpx;right:17rpx;top:18rpx;height:27rpx;border:3rpx solid #fff;border-radius:8rpx}.cube-dot{position:absolute;right:20rpx;bottom:14rpx;width:8rpx;height:8rpx;border-radius:50%;background:#fff}.identity-main{flex:1;min-width:0}.identity-name{max-width:320rpx;font-size:29rpx;font-weight:720;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.online-dot{width:11rpx;height:11rpx;margin-left:10rpx;border-radius:50%;background:#49efb9;box-shadow:0 0 0 6rpx rgba(73,239,185,.14)}.identity-model{display:block;margin-top:5rpx;color:rgba(255,255,255,.72);font-size:20rpx}.identity-status{margin-top:27rpx;display:flex;align-items:center;gap:15rpx}.status-label{display:block;color:rgba(255,255,255,.7);font-size:18rpx}.status-number{display:block;font-size:25rpx;font-weight:700}.quality-track{flex:1;height:8rpx;border-radius:8rpx;background:rgba(255,255,255,.22);overflow:hidden}.quality-fill{height:100%;border-radius:8rpx;background:#55efbd}.status-good{font-size:20rpx;color:#d8fff2}.identity-chips{margin-top:21rpx;display:flex;gap:10rpx;flex-wrap:wrap}.identity-chips text{padding:7rpx 12rpx;border-radius:12rpx;background:rgba(255,255,255,.14);color:rgba(255,255,255,.82);font-size:17rpx}
.setting-group{padding:0 24rpx}.setting-row{min-height:115rpx;display:flex;align-items:center;gap:17rpx}.setting-icon{width:62rpx;height:62rpx;flex:none;border-radius:21rpx;display:flex;align-items:center;justify-content:center;font-size:18rpx;font-weight:800}.setting-icon--blue{color:#167be8;background:#e5f2ff}.setting-icon--violet{color:#7060e5;background:#eeebff}.setting-icon--cyan{color:#159daf;background:#e1f8fb}.wifi-wave{font-size:35rpx;transform:rotate(-25deg)}.setting-main{flex:1;min-width:0}.setting-title{display:block;color:#173854;font-size:25rpx;font-weight:700}.setting-copy{display:block;margin-top:4rpx;color:#71899e;font-size:19rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.setting-next{color:#8ba1b3;font-size:34rpx}.setting-divider{height:1rpx;margin-left:79rpx;background:#e6eef5}
.info-grid{padding:8rpx 22rpx;display:grid;grid-template-columns:1fr 1fr}.info-cell{padding:21rpx 8rpx;color:#7890a5;font-size:19rpx;border-bottom:1rpx solid #e8eff5}.info-cell:nth-last-child(-n+2){border-bottom:0}.info-cell:nth-child(odd){border-right:1rpx solid #e8eff5}.info-cell:nth-child(even){padding-left:24rpx}.info-value{display:block;margin-top:5rpx;color:#294d69;font-size:22rpx;font-weight:650}
.permission-list{padding:5rpx 24rpx}.permission-row{min-height:93rpx;display:flex;align-items:center;gap:15rpx;border-bottom:1rpx solid #e8eff5}.permission-row:last-child{border-bottom:0}.permission-mark{width:39rpx;height:39rpx;flex:none;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-size:20rpx;font-weight:700}.permission-mark--yes{color:#0ba276;background:#e3f8f0}.permission-mark--no{color:#8297a8;background:#edf3f7}.permission-title{display:block;color:#254761;font-size:23rpx;font-weight:650}.permission-code{display:block;margin-top:2rpx;color:#8aa0b2;font-size:17rpx}.permission-state{color:#71899e;font-size:19rpx}.permission-state--yes{color:#0e9d73}
.security-card{margin-top:22rpx;padding:21rpx;display:flex;align-items:flex-start;gap:15rpx;border-radius:25rpx;background:#e7f8f2;border:1rpx solid #cbeee2}.security-shield{width:47rpx;height:52rpx;flex:none;border-radius:18rpx 18rpx 22rpx 22rpx;background:#18b785;color:#fff;font-size:23rpx;font-weight:700;display:flex;align-items:center;justify-content:center}.security-title{display:block;color:#276553;font-size:23rpx;font-weight:700}.security-copy{display:block;margin-top:3rpx;color:#507c6e;font-size:19rpx;line-height:1.55}.diagnosis-btn{width:100%;margin-top:23rpx}.pairing-btn{width:100%;margin-top:13rpx}.identity-card--empty{min-height:180rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}.empty-title{font-size:30rpx;font-weight:700}.empty-copy{margin-top:8rpx;color:rgba(255,255,255,.75);font-size:21rpx}
